# ── Environment ──────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Node / Next.js ───────────────────────────────────────────
node_modules/
frontend/.next/
frontend/out/
frontend/.netlify/
.npm
npm-debug.log*
yarn-error.log*

# ── Python / FastAPI ─────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
pip-log.txt

# ── ML model weights ─────────────────────────────────────────
*.pt
*.pth
*.bin
*.onnx
model/phase1_best.pt
model/optimal_thresholds.json

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Misc ──────────────────────────────────────────────────────
*.log
*.tmp
coverage/
.nyc_output/

# MIMIC seed data — not for source control
scripts/sample_notes_seed.json
scripts/_reseed_from_mimic.py
.claude/worktrees/

# Timestamped .env backups. `*.env` does not match these: it matches names
# ENDING in .env, and these end in .bak.<timestamp>.
.env.bak.*
.env.*.bak

# ── Credentials that arrive as files ─────────────────────────
# The AWS console hands you access keys as a .csv download, and it lands in
# whatever directory you were in. Never source control.
*accessKeys*.csv
*credentials*.csv
*.pem
*.key

# ── Staged model artifacts ───────────────────────────────────
# artifacts/fullcode is assembled by scripts/stage_fullcode_artifacts.py and
# uploaded to S3. Derived content, some of it symlinks to a 758MB checkpoint
# outside this repo. S3 is the source of truth; the script rebuilds the rest.
artifacts/

# ── Scratch output ───────────────────────────────────────────
gate_probe.json
*.tsbuildinfo
