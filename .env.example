# ── Supabase ──────────────────────────────────────────────────
# URL: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable / anon key  →  Project Settings → API → Project API keys
#   New format (preferred): sb_publishable_...
#   Old format (still works): eyJ... (labelled "anon" key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_ANON_KEY=sb_publishable_...

# Secret / service-role key  →  Project Settings → API → Project API keys
#   New format (preferred): sb_secret_...
#   Old format (still works): eyJ... (labelled "service_role" key)
#   ⚠ Never expose this in the frontend or any public repo
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Frontend (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.roshan-ai.com

# ── LLM ──────────────────────────────────────────────────────
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# ── AWS (Bedrock + S3) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_PRIMARY_MODEL=meta.llama3-3-70b-instruct-v1:0
BEDROCK_FALLBACK_MODEL=anthropic.claude-sonnet-4-20250514-v1:0

# ── Model / S3 ────────────────────────────────────────────────
MODEL_SOURCE=s3
S3_BUCKET=shifamind-models
S3_MODEL_KEY=phase1/phase1_best.pt
S3_THRESHOLDS_KEY=phase1/optimal_thresholds.json
DEVICE=cpu

# ── App ───────────────────────────────────────────────────────
SECRET_KEY=generate-a-random-secret-here
CORS_ORIGINS=https://platform.roshan-ai.com,https://platform.shifamind.me,http://localhost:3000

# ── Seed Scripts ──────────────────────────────────────────────
SEED_PASSWORD=ShifaMind2025!
